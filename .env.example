# --- AI & EXTERNAL APIS ---
# GEMINI_API_KEY: Required for Gemini AI voice command parsing and smart entry features.
# AI Studio automatically injects this if configured in the Secrets panel.
GEMINI_API_KEY="your_gemini_api_key_here"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps integration (Dealer locations, directions).
# This can be set in the Secrets panel as well.
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_key_here"

# --- APPLICATION URL ---
# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime.
APP_URL="https://your-app-url.vercel.app"

# --- DATABASE CONFIGURATION (Managed by AI Studio) ---
# These are automatically injected when using Cloud SQL.
# Manual configuration is not typically required in the UI.
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="sonu_bhatti_db"
