rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products collection: public read, write allowed for server-side sync & admin updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: public create & read
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Settings collection: public read, write allowed for server-side sync & admin updates
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // User profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Movements collection
    match /movements/{movementId} {
      allow read, write: if true;
    }

    // Images collection: public read, validated base64 write size (< 900KB)
    match /images/{imageId} {
      allow read: if true;
      allow write: if isValidId(imageId)
        && request.resource.data.dataBase64 is string
        && request.resource.data.dataBase64.size() <= 900000
        && request.resource.data.mimeType is string
        && request.resource.data.mimeType.size() <= 64;
    }
  }
}
